# ─────────────────────────────────────────────────────────────────────────────
#  Groq API configuration  (server-side ONLY — never exposed to the browser)
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: the variable is GROQ_API_KEY with NO "VITE_" prefix.
# Anything prefixed with VITE_ gets bundled into the public frontend JS and would
# leak your key. This key is read only by the serverless function in /api/chat.js.
#
# Local development:
#   1) copy this file to ".env.local"
#   2) put your real key below
#   3) run `vercel dev` (NOT `npm run dev`) so the /api function is available
#
# Production (Vercel):
#   Add GROQ_API_KEY in  Project → Settings → Environment Variables.
#
# Get a key at: https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here
